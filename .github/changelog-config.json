{
  "template": "# What's Changed\n\n#{{CHANGELOG}}",
  "label_extractor": [
    {
      "pattern": "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\\([^)]*\\))?(!)?:\\s[\\s\\S]*",
      "on_property": "title",
      "target": "$1"
    }
  ],
  "categories": [
    {
      "title": "## 🚀 New Features",
      "labels": ["feat"],
      "titleType": "PLURAL"
    },
    {
      "title": "## 💎 Improvements",
      "labels": ["refactor", "perf", "style"],
      "titleType": "PLURAL"
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["fix"],
      "titleType": "PLURAL"
    },
    {
      "title": "## 🧰 Maintenance",
      "labels": ["chore", "docs", "build", "ci", "test", "revert", "deps"],
      "titleType": "PLURAL"
    }
  ],
  "ignore_labels": [],
  "sort": "ASC",
  "hide_empty": true,
  "group_by": "labels"
}